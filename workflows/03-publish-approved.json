      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4560,
        40
      ],
      "parameters": {
        "jsCode": "function classify(s) {\n  if (s >= 200 && s < 300) return 'ok';\n  if (s === 308) return 'partial';\n  if (s === 404 || s === 410) return 'expired';\n  if (s === 0 || s === 429 || s >= 500) return 'retry';\n  return 'fatal';\n}\nfunction why(r, status) {\n  let m = '';\n  try { m = typeof r.body === 'string' ? r.body : JSON.stringify(r.body || ''); } catch (e) { m = ''; }\n  const net = r.error ? (r.error.message || String(r.error)) : '';\n  return ('HTTP ' + status + ' ' + (net || m)).replace(/\\s+/g, ' ').slice(0, 300);\n}\nconst YT_ID = /^[A-Za-z0-9_-]{11}$/;\nconst ctx = $('Plan upload').first().json;\nconst r = $input.first().json;\nconst status = r.statusCode || 0;\nconst kind = classify(status);\nif (kind === 'ok') {\n  const id = r.body && r.body.id;\n  if (typeof id === 'string' && YT_ID.test(id)) return [{ json: { ...ctx, state: 'ok', youtube_id: id } }];\n  return [{ json: { ...ctx, state: 'fatal', error: 'the upload finished but the response has no video id', retryable: false } }];\n}\n// 308 (incompleto), 5xx, 429 ou queda de conexão: a próxima reivindicação consulta a sessão e continua de onde parou\nconst retry = kind === 'retry' || kind === 'partial' || kind === 'expired';\nreturn [{ json: { ...ctx, state: retry ? 'retry' : 'fatal', error: why(r, status), retryable: retry } }];"
      }
