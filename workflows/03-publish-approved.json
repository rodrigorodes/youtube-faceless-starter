        "jsCode": "const it = $input.first().json.item;\nconst cfg = $('Config').first().json;\nreturn [{ json: {\n  pid: it.publication.id, attempt: it.publication.attempt, upload_uri: it.publication.upload_uri || '',\n  size: it.file_size, file_path: it.file_path, thumb_path: it.thumbnail_path, body: it.youtube_body, offset: 0,\n  debug_wait_after: cfg.debug_wait_after,\n} }];"
      }
