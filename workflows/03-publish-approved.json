{
  "name": "03 - Publicar aprovado (Core executa; n8n orquestra)",
  "nodes": [
    {
      "parameters": {},
      "id": "every-2-minutes",
      "name": "Every 2 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -260,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "publish-approved",
        "webhookId": "e7f3b1d0-6c2a-4c55-9a6b-1f1a9d3f7a01",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "run-now-webhook",
      "name": "Run now (webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -260,
        200
      ],
      "webhookId": "e7f3b1d0-6c2a-4c55-9a6b-1f1a9d3f7a01"
    },
    {
      "parameters": {
        "jsCode": "// O webhook não controla lease nem tentativas: o Core decide a política.\nreturn [{ json: { lease_seconds: 5400, max_attempts: 3 } }];"
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://renderer:8000/studio/publications/execute",
        "authentication": "genericCredentialType",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 1800000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "execute-core",
      "name": "Execute (Core)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        180,
        100
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.result }}",
                    "rightValue": "UPLOADED",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "publicado"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.result }}",
                    "rightValue": "IDLE",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "nada"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.result }}",
                    "rightValue": "RECONCILE",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "reconciliar"
            }
          ]
        },
        "options": {
          "fallbackOutput": 3
        }
      },
      "id": "result",
      "name": "Result",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        420,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://renderer:8000/studio/publications/' + $json.body.publication.id + '/thumbnail-set' }}",
        "authentication": "genericCredentialType",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 1800000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}"
      },
      "id": "set-thumbnail",
      "name": "Set thumbnail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Miniatura é acessório: falha aqui não desfaz a publicação (o Core registra).\nreturn [{ json: { thumbnail_ok: $json.statusCode === 200 } }];"
      },
      "id": "thumbnail-outcome",
      "name": "Thumbnail outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        0
      ]
    },
    {
      "parameters": {},
      "id": "nothing-to-do",
      "name": "Nada a publicar",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        120
      ]
    },
    {
      "parameters": {},
      "id": "needs-reconcile",
      "name": "Reconciliação necessária",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        220
      ]
    },
    {
      "parameters": {},
      "id": "blocked-or-dlq",
      "name": "Bloqueado ou DLQ",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        320
      ]
    }
  ],
