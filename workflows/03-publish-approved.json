      ],
      "parameters": {
        "jsCode": "function classify(s) {\n  if (s >= 200 && s < 300) return 'ok';\n  if (s === 308) return 'partial';\n  if (s === 404 || s === 410) return 'expired';\n  if (s === 0 || s === 429 || s >= 500) return 'retry';\n  return 'fatal';\n}\nfunction why(r, status) {\n  let m = '';\n  try { m = typeof r.body === 'string' ? r.body : JSON.stringify(r.body || ''); } catch (e) { m = ''; }\n  const net = r.error ? (r.error.message || String(r.error)) : '';\n  return ('HTTP ' + status + ' ' + (net || m)).replace(/\\s+/g, ' ').slice(0, 300);\n}\nconst YT_ID = /^[A-Za-z0-9_-]{11}$/;\nconst ctx = $('Build context').first().json;\nconst r = $input.first().json;\nconst status = r.statusCode || 0;\nconst kind = classify(status);\nconst loc = r.headers && (r.headers.location || r.headers.Location);\nif (kind === 'ok' && typeof loc === 'string' && loc) return [{ json: { ...ctx, state: 'ok', upload_uri: loc, offset: 0 } }];\nconst retry = kind === 'retry';\nreturn [{ json: { ...ctx, upload_uri: '', state: retry ? 'retry' : 'fatal', error: kind === 'ok' ? 'no upload session URL in the response' : why(r, status), retryable: retry } }];"
      }
