{
  "$defs": {
    "ProductionMode": {
      "enum": [
        "piloto",
        "diretor"
      ],
      "title": "ProductionMode",
      "type": "string"
    },
    "QaCoverage": {
      "additionalProperties": false,
      "description": "Cobertura declarada do QA: distingue \"não verificado\" de \"verificado sem problemas\".",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "verified",
            "not_verified"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "QaCoverage",
      "type": "object"
    },
    "QaFinding": {
      "additionalProperties": false,
      "description": "Achado de um check: categoria, severidade, evidência e ação sugerida (F6-06).\n\n``finding_id`` identifica o achado; ``check_id`` identifica o check que o\nproduziu. Dois achados do mesmo check são válidos desde que tenham\n``finding_id`` distintos. Evidência é obrigatória e não vazia: achado sem\nevidência não é verificável. ``suggested_action`` é a correção sugerida ao\noperador; é sempre uma sugestão, nunca aplicada por este contrato.",
      "properties": {
        "auto_fixable": {
          "default": false,
          "title": "Auto Fixable",
          "type": "boolean"
        },
        "category": {
          "enum": [
            "technical",
            "editorial"
          ],
          "title": "Category",
          "type": "string"
        },
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "finding_id": {
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "needs_human": {
          "default": false,
          "title": "Needs Human",
          "type": "boolean"
        },
        "scene_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "shot_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shot Id"
        },
        "suggested_action": {
          "minLength": 1,
          "title": "Suggested Action",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "check_id",
        "category",
        "severity",
        "evidence",
        "suggested_action"
      ],
      "title": "QaFinding",
      "type": "object"
    },
    "QaReport": {
      "additionalProperties": false,
      "description": "Relatório de QA vinculado a um render por ``render_id`` + ``checksum``.\n\nValida apenas a coerência interna: identidade exata e visível, cobertura\ndeclarada, ``finding_id``/``checks_run`` únicos e achados rastreáveis a um\ncheck executado. Não executa nem confirma nenhum check.",
      "properties": {
        "checks_run": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Checks Run",
          "type": "array"
        },
        "checksum": {
          "minLength": 1,
          "title": "Checksum",
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/QaCoverage"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QaFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "render_id": {
          "minLength": 1,
          "title": "Render Id",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "render_id",
        "checksum",
        "generated_at",
        "coverage"
      ],
      "title": "QaReport",
      "type": "object"
    },
    "VideoFormat": {
      "enum": [
        "short",
        "long"
      ],
      "title": "VideoFormat",
      "type": "string"
    },
    "VideoStatus": {
      "enum": [
        "IDEA",
        "SCRIPTED",
        "FACT_CHECKED",
        "STORYBOARDED",
        "ASSETS_READY",
        "RENDERED",
        "AWAITING_APPROVAL",
        "APPROVED",
        "PUBLISHED",
        "REJECTED",
        "FAILED"
      ],
      "title": "VideoStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget_cap_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Cap Usd"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "creative_brief": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Creative Brief"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "format": {
      "$ref": "#/$defs/VideoFormat"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "pacing_preset": {
      "default": "dynamic",
      "title": "Pacing Preset",
      "type": "string"
    },
    "privacy": {
      "default": "private",
      "enum": [
        "private",
        "unlisted",
        "public"
      ],
      "title": "Privacy",
      "type": "string"
    },
    "production_mode": {
      "allOf": [
        {
          "$ref": "#/$defs/ProductionMode"
        }
      ],
      "default": "piloto"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "qa_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/QaReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "allOf": [
        {
          "$ref": "#/$defs/VideoStatus"
        }
      ],
      "default": "IDEA"
    },
    "style_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Style Id"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "target_duration_s": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Duration S"
    },
    "title": {
      "default": "",
      "title": "Title",
      "type": "string"
    },
    "topic": {
      "maxLength": 300,
      "minLength": 3,
      "title": "Topic",
      "type": "string"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    }
  },
  "required": [
    "id",
    "project_id",
    "topic",
    "format"
  ],
  "title": "Video",
  "type": "object"
}
