{
  "$defs": {
    "JobStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "JobStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "default": 1,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "input_hash": {
      "default": "",
      "title": "Input Hash",
      "type": "string"
    },
    "output_asset_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Asset Id"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/JobStatus",
      "default": "QUEUED"
    },
    "video_id": {
      "title": "Video Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "video_id"
  ],
  "title": "RenderJob",
  "type": "object"
}
