{
  "$defs": {
    "SceneAsset": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "end_s": {
          "title": "End S",
          "type": "number"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "motion": {
          "default": "none",
          "title": "Motion",
          "type": "string"
        },
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "role": {
          "default": "base",
          "enum": [
            "base",
            "overlay"
          ],
          "title": "Role",
          "type": "string"
        },
        "scene_id": {
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "start_s": {
          "minimum": 0.0,
          "title": "Start S",
          "type": "number"
        },
        "transition_duration_s": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Transition Duration S",
          "type": "number"
        },
        "transition_kind": {
          "default": "none",
          "title": "Transition Kind",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "asset_id",
        "position",
        "start_s",
        "end_s"
      ],
      "title": "SceneAsset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Id"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/SceneAsset"
      },
      "title": "Assets",
      "type": "array"
    },
    "broll_enabled": {
      "default": false,
      "title": "Broll Enabled",
      "type": "boolean"
    },
    "broll_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Broll Note"
    },
    "caption": {
      "default": "",
      "maxLength": 110,
      "title": "Caption",
      "type": "string"
    },
    "claim_ids": {
      "items": {
        "type": "string"
      },
      "title": "Claim Ids",
      "type": "array"
    },
    "duration_s": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration S"
    },
    "edit_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Edit Revision",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "idx": {
      "minimum": 0,
      "title": "Idx",
      "type": "integer"
    },
    "image_prompt": {
      "maxLength": 500,
      "minLength": 10,
      "title": "Image Prompt",
      "type": "string"
    },
    "label": {
      "default": "",
      "maxLength": 32,
      "title": "Label",
      "type": "string"
    },
    "narration": {
      "maxLength": 400,
      "minLength": 5,
      "title": "Narration",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "search_queries": {
      "items": {
        "type": "string"
      },
      "title": "Search Queries",
      "type": "array"
    },
    "video_id": {
      "title": "Video Id",
      "type": "string"
    },
    "visual_intent": {
      "default": "",
      "title": "Visual Intent",
      "type": "string"
    }
  },
  "required": [
    "id",
    "video_id",
    "idx",
    "narration",
    "image_prompt"
  ],
  "title": "Scene",
  "type": "object"
}
