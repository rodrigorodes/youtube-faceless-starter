{
  "$defs": {
    "AssetReference": {
      "additionalProperties": false,
      "description": "Referência a conteúdo previamente gerado ou obtido (imagem, vídeo, gráfico, texto).",
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "asset_version": {
          "minimum": 1,
          "title": "Asset Version",
          "type": "integer"
        },
        "attribution": {
          "default": "",
          "title": "Attribution",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "media_type": {
          "enum": [
            "image",
            "video",
            "graphic",
            "text"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metadata",
          "type": "object"
        },
        "source_url": {
          "default": "",
          "title": "Source Url",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "asset_version",
        "uri",
        "content_sha256",
        "media_type"
      ],
      "title": "AssetReference",
      "type": "object"
    },
    "AudioMix": {
      "additionalProperties": false,
      "description": "Parâmetros declarativos da mixagem de áudio do plano.",
      "properties": {
        "afade_in_s": {
          "default": 0.25,
          "title": "Afade In S",
          "type": "number"
        },
        "afade_out_s": {
          "default": 0.25,
          "title": "Afade Out S",
          "type": "number"
        },
        "ducking_ratio": {
          "default": 10.0,
          "title": "Ducking Ratio",
          "type": "number"
        },
        "ducking_threshold": {
          "default": 0.02,
          "title": "Ducking Threshold",
          "type": "number"
        },
        "loudnorm_i": {
          "default": -16.0,
          "title": "Loudnorm I",
          "type": "number"
        },
        "loudnorm_lra": {
          "default": 11.0,
          "title": "Loudnorm Lra",
          "type": "number"
        },
        "loudnorm_tp": {
          "default": -1.5,
          "title": "Loudnorm Tp",
          "type": "number"
        },
        "music_gain": {
          "default": 0.4,
          "title": "Music Gain",
          "type": "number"
        }
      },
      "title": "AudioMix",
      "type": "object"
    },
    "Composition": {
      "additionalProperties": false,
      "description": "Como o conteúdo do shot preenche o quadro.",
      "properties": {
        "fit": {
          "default": "cover",
          "enum": [
            "cover",
            "contain"
          ],
          "title": "Fit",
          "type": "string"
        }
      },
      "title": "Composition",
      "type": "object"
    },
    "ConfigSnapshot": {
      "additionalProperties": false,
      "description": "Referência da **configuração efetiva congelada** que governou voz e render (F03.T03).\n\nO plano grava a identidade (`content_hash` + `schema_version`) e a proveniência criativa\nrelevante ao render (``style`` e ``audiovisual.*``). O documento completo da configuração\ncontinua sendo o snapshot do run (F03.T02); aqui só entra a prova de qual revisão foi usada,\npara auditar um plano sem copiar nem credencial nem política operacional.\n\nCampo **aditivo**: planos persistidos antes desta fatia não o têm e continuam válidos\n(``None``). Ele não participa dos fingerprints do cache (``domain.render_cache``), então\ntambém não invalida artefatos já registrados.",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "provenance": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Provenance",
          "type": "object"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "content_hash",
        "schema_version"
      ],
      "title": "ConfigSnapshot",
      "type": "object"
    },
    "Effects": {
      "additionalProperties": false,
      "description": "Movimento explícito por shot (substitui o ``index % 4`` do renderer legado).",
      "properties": {
        "motion": {
          "default": "none",
          "enum": [
            "none",
            "zoom_in",
            "zoom_out",
            "pan_left",
            "pan_right"
          ],
          "title": "Motion",
          "type": "string"
        }
      },
      "title": "Effects",
      "type": "object"
    },
    "GeneratedAudioSource": {
      "additionalProperties": false,
      "description": "Fonte de áudio **gerada** pelo render (voz sintetizada ou trilha musical).\n\nDistinta de ``AssetReference`` (C2): não é ``Asset`` persistido nem tem\n``content_sha256``. A trilha musical é determinística pelos ``params`` (bpm,\nseed). ``silent=True`` representa o modo ``music=False`` do renderer, que grava\numa trilha silenciosa de mesmo comprimento para manter o grafo de mixagem.",
      "properties": {
        "duration_ticks": {
          "minimum": 1,
          "title": "Duration Ticks",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "voice",
            "music"
          ],
          "title": "Kind",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        },
        "silent": {
          "default": false,
          "title": "Silent",
          "type": "boolean"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "kind",
        "duration_ticks"
      ],
      "title": "GeneratedAudioSource",
      "type": "object"
    },
    "NarrationCue": {
      "additionalProperties": false,
      "description": "Narração associada a uma cena e a um intervalo da timeline (RP-013).",
      "properties": {
        "duration_ticks": {
          "minimum": 1,
          "title": "Duration Ticks",
          "type": "integer"
        },
        "scene_id": {
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "start_tick": {
          "minimum": 0,
          "title": "Start Tick",
          "type": "integer"
        },
        "track_id": {
          "minLength": 1,
          "title": "Track Id",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "track_id",
        "source_ref",
        "start_tick",
        "duration_ticks"
      ],
      "title": "NarrationCue",
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "description": "Formato de saída e texto de disclosure (R3). A taxa de quadros é da ``Timebase``.",
      "properties": {
        "disclosure": {
          "default": "Ilustração gerada por IA",
          "minLength": 1,
          "title": "Disclosure",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/VideoFormat"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "format",
        "width",
        "height"
      ],
      "title": "Output",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Proveniência do documento (quem construiu o plano).",
      "properties": {
        "builder_version": {
          "minLength": 1,
          "title": "Builder Version",
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        }
      },
      "required": [
        "builder_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "description": "Unidade narrativa: agrupa shots visuais.",
      "properties": {
        "duration_ticks": {
          "minimum": 1,
          "title": "Duration Ticks",
          "type": "integer"
        },
        "paid_operation_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paid Operation Key"
        },
        "scene_id": {
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "shots": {
          "items": {
            "$ref": "#/$defs/Shot"
          },
          "minItems": 1,
          "title": "Shots",
          "type": "array"
        },
        "start_tick": {
          "minimum": 0,
          "title": "Start Tick",
          "type": "integer"
        }
      },
      "required": [
        "scene_id",
        "start_tick",
        "duration_ticks",
        "shots"
      ],
      "title": "Scene",
      "type": "object"
    },
    "Shot": {
      "additionalProperties": false,
      "description": "Elemento visual em uma faixa temporal, dentro de uma cena.\n\n``role`` distingue a base (que cobre a cena) do overlay de imagem (VE-01): o overlay\nvive dentro de um segmento base e não fecha lacuna. ``z_index`` ordena camadas; a base\nfica em 0 e o overlay em 1+.",
      "properties": {
        "asset_offset_ticks": {
          "default": 0,
          "minimum": 0,
          "title": "Asset Offset Ticks",
          "type": "integer"
        },
        "asset_ref": {
          "minLength": 1,
          "title": "Asset Ref",
          "type": "string"
        },
        "composition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Composition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duration_ticks": {
          "minimum": 1,
          "title": "Duration Ticks",
          "type": "integer"
        },
        "effects": {
          "$ref": "#/$defs/Effects"
        },
        "paid_operation_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paid Operation Key"
        },
        "role": {
          "default": "base",
          "enum": [
            "base",
            "overlay"
          ],
          "title": "Role",
          "type": "string"
        },
        "shot_id": {
          "minLength": 1,
          "title": "Shot Id",
          "type": "string"
        },
        "start_tick": {
          "minimum": 0,
          "title": "Start Tick",
          "type": "integer"
        },
        "track_id": {
          "minLength": 1,
          "title": "Track Id",
          "type": "string"
        },
        "transition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "z_index": {
          "default": 0,
          "minimum": 0,
          "title": "Z Index",
          "type": "integer"
        }
      },
      "required": [
        "shot_id",
        "track_id",
        "start_tick",
        "duration_ticks",
        "asset_ref"
      ],
      "title": "Shot",
      "type": "object"
    },
    "StyleSnapshot": {
      "additionalProperties": false,
      "description": "Referência por chave + versão ao perfil de canal (R4); não carrega o objeto.",
      "properties": {
        "source": {
          "const": "channel",
          "default": "channel",
          "title": "Source",
          "type": "string"
        },
        "style_id": {
          "minLength": 1,
          "title": "Style Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "style_id",
        "version"
      ],
      "title": "StyleSnapshot",
      "type": "object"
    },
    "SubtitleCue": {
      "additionalProperties": false,
      "description": "Legenda associada a uma cena e a um intervalo da timeline (RP-013).",
      "properties": {
        "duration_ticks": {
          "minimum": 1,
          "title": "Duration Ticks",
          "type": "integer"
        },
        "scene_id": {
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "start_tick": {
          "minimum": 0,
          "title": "Start Tick",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "track_id": {
          "minLength": 1,
          "title": "Track Id",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "track_id",
        "text",
        "start_tick",
        "duration_ticks"
      ],
      "title": "SubtitleCue",
      "type": "object"
    },
    "Timebase": {
      "additionalProperties": false,
      "description": "Timebase racional do plano: fps como fração e resolução inteira em ticks.\n\n``fps_num``/``fps_den`` representam exatamente taxas como ``30000/1001``.\n``ticks_per_second`` é explícito. A grade de ticks tem de conter toda fronteira\nde quadro: reduzido, ``fps_num`` precisa dividir ``ticks_per_second``, senão um\nquadro cai entre dois ticks e a duração deixa de ser reproduzível.",
      "properties": {
        "fps_den": {
          "default": 1,
          "minimum": 1,
          "title": "Fps Den",
          "type": "integer"
        },
        "fps_num": {
          "default": 25,
          "minimum": 1,
          "title": "Fps Num",
          "type": "integer"
        },
        "ticks_per_second": {
          "minimum": 1,
          "title": "Ticks Per Second",
          "type": "integer"
        }
      },
      "required": [
        "ticks_per_second"
      ],
      "title": "Timebase",
      "type": "object"
    },
    "Timeline": {
      "additionalProperties": false,
      "description": "Timebase, tracks, cenas e as cues de narração/legenda da timeline.",
      "properties": {
        "narration": {
          "items": {
            "$ref": "#/$defs/NarrationCue"
          },
          "title": "Narration",
          "type": "array"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/Scene"
          },
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        },
        "subtitles": {
          "items": {
            "$ref": "#/$defs/SubtitleCue"
          },
          "title": "Subtitles",
          "type": "array"
        },
        "timebase": {
          "$ref": "#/$defs/Timebase"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/Track"
          },
          "minItems": 1,
          "title": "Tracks",
          "type": "array"
        }
      },
      "required": [
        "timebase",
        "tracks",
        "scenes"
      ],
      "title": "Timeline",
      "type": "object"
    },
    "Track": {
      "additionalProperties": false,
      "description": "Faixa da timeline; shots exigem faixa ``visual``, cues exigem a faixa do seu tipo.",
      "properties": {
        "kind": {
          "enum": [
            "visual",
            "narration",
            "subtitle"
          ],
          "title": "Kind",
          "type": "string"
        },
        "track_id": {
          "minLength": 1,
          "title": "Track Id",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "kind"
      ],
      "title": "Track",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "description": "Transição para o próximo shot.",
      "properties": {
        "duration_ticks": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ticks",
          "type": "integer"
        },
        "kind": {
          "default": "none",
          "enum": [
            "none",
            "fade",
            "crossfade",
            "cut"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "Transition",
      "type": "object"
    },
    "VideoFormat": {
      "enum": [
        "short",
        "long"
      ],
      "title": "VideoFormat",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Raiz do documento audiovisual canônico, versionado por ``schema_version``.",
  "properties": {
    "asset_manifest": {
      "items": {
        "$ref": "#/$defs/AssetReference"
      },
      "title": "Asset Manifest",
      "type": "array"
    },
    "audio_mix": {
      "$ref": "#/$defs/AudioMix"
    },
    "config_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConfigSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "generated_audio": {
      "items": {
        "$ref": "#/$defs/GeneratedAudioSource"
      },
      "title": "Generated Audio",
      "type": "array"
    },
    "output": {
      "$ref": "#/$defs/Output"
    },
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "style_snapshot": {
      "$ref": "#/$defs/StyleSnapshot"
    },
    "timeline": {
      "$ref": "#/$defs/Timeline"
    },
    "video_id": {
      "minLength": 1,
      "title": "Video Id",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "revision",
    "project_id",
    "video_id",
    "output",
    "timeline",
    "style_snapshot",
    "provenance"
  ],
  "title": "RenderPlan",
  "type": "object"
}
