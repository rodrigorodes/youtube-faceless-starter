{
  "$defs": {
    "QaCoverage": {
      "additionalProperties": false,
      "description": "Cobertura declarada do QA: distingue \"não verificado\" de \"verificado sem problemas\".",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "verified",
            "not_verified"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "QaCoverage",
      "type": "object"
    },
    "QaFinding": {
      "additionalProperties": false,
      "description": "Achado de um check: categoria, severidade, evidência e ação sugerida (F6-06).\n\n``finding_id`` identifica o achado; ``check_id`` identifica o check que o\nproduziu. Dois achados do mesmo check são válidos desde que tenham\n``finding_id`` distintos. Evidência é obrigatória e não vazia: achado sem\nevidência não é verificável. ``suggested_action`` é a correção sugerida ao\noperador; é sempre uma sugestão, nunca aplicada por este contrato.",
      "properties": {
        "auto_fixable": {
          "default": false,
          "title": "Auto Fixable",
          "type": "boolean"
        },
        "category": {
          "enum": [
            "technical",
            "editorial"
          ],
          "title": "Category",
          "type": "string"
        },
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "finding_id": {
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "needs_human": {
          "default": false,
          "title": "Needs Human",
          "type": "boolean"
        },
        "scene_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "shot_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shot Id"
        },
        "suggested_action": {
          "minLength": 1,
          "title": "Suggested Action",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "check_id",
        "category",
        "severity",
        "evidence",
        "suggested_action"
      ],
      "title": "QaFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Relatório de QA vinculado a um render por ``render_id`` + ``checksum``.\n\nValida apenas a coerência interna: identidade exata e visível, cobertura\ndeclarada, ``finding_id``/``checks_run`` únicos e achados rastreáveis a um\ncheck executado. Não executa nem confirma nenhum check.",
  "properties": {
    "checks_run": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Checks Run",
      "type": "array"
    },
    "checksum": {
      "minLength": 1,
      "title": "Checksum",
      "type": "string"
    },
    "coverage": {
      "$ref": "#/$defs/QaCoverage"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/QaFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "render_id": {
      "minLength": 1,
      "title": "Render Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "render_id",
    "checksum",
    "generated_at",
    "coverage"
  ],
  "title": "QaReport",
  "type": "object"
}
