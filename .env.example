POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS
TZ=America/Sao_Paulo

# Gemini API key (API key). NÃO é lida pelo código atual (nem pelo renderer): mantida vazia
# porque o starter exige exatamente a linha `GEMINI_API_KEY=` (tests/test_secrets_hygiene.py).
GEMINI_API_KEY=

# OpenCode bridge. As variáveis OPENCODE_* abaixo são do BRIDGE (scripts/opencode-bridge.py),
# não do estúdio/provedor: o bridge escolhe o modelo real e roda no HOST; o estúdio o alcança por
# OPENCODE_BRIDGE_URL/TOKEN e escolhe o provider por STUDIO_TEXT/STUDIO_IMAGE (mais abaixo).
# Veja docs/07-openai-luna-oauth.md. Token: >= 16 caracteres aleatórios, diferente dos demais segredos.
OPENCODE_BRIDGE_TOKEN=
OPENCODE_BRIDGE_URL=http://host.docker.internal:8787
OPENCODE_BRIDGE_PORT=8787
OPENCODE_MODEL=openai/gpt-6-luna
# Imagens do modo rich: só modelos ':free' (o bridge recusa os demais).
OPENCODE_IMAGE_MODEL=openrouter/recraft/recraft-v4.1-flash-v2:free

# Estúdio: credenciais do browser e do worker.
# Gere credenciais aleatórias distintas e persistentes no .env privado; veja docs/17-studio-auth.md.
STUDIO_BROWSER_USER=
STUDIO_BROWSER_PASSWORD=
STUDIO_WORKER_TOKEN=

# Estúdio: provedor padrão de cada porta (`<provedor>:<modelo>`). Vazio usa o default indicado
# no comentário; o `config` do projeto sobrescreve por projeto. Veja docs/04-variaveis-de-ambiente.md.
#   text     = opencode:openai/gpt-6-luna
#   image    = opencode:openrouter/recraft/recraft-v4.1-flash-v2:free
#   voice    = piper:pt_BR-faber-medium
#   renderer = ffmpeg:rich
STUDIO_TEXT=
STUDIO_IMAGE=
STUDIO_VOICE=
STUDIO_RENDERER=

# Estúdio: voz Piper (porta voice). O modelo do spec vira o arquivo /opt/voices/<modelo>.onnx.
# Vozes pt_BR do repositório do Piper: faber/medium (default), cadu/medium, jeff/medium, edresson/low.
# Trocar a voz invalida a calibração de duração (domain/narration_duration.py mediu só
# pt_BR-faber-medium): recalibre com scripts/tts_calibration.py. PIPER_VOICE (caminho explícito)
# tem precedência sobre o modelo do spec.
PIPER_VOICE=

# Estúdio: chave do Pexels para `STUDIO_IMAGE=stock:pexels`.
PEXELS_API_KEY=
# Estúdio: reserva preventiva de orçamento nos caminhos pagos (R1/P-07). Default LIGADO (W0B.1);
# a prova de que o limite do canal impede a chamada paga ANTES do efeito externo, inclusive sob
# concorrência, está em tests/test_budget_guard_wiring.py.
# 1/on: editorial, imagem, voz e pontuação de ideias exigem reserva no banco antes da chamada; o
# limite do CANAL (`channel_budgets`, quando existir) manda e o teto global das settings continua
# valendo em paralelo; custo sem evidência de cobrança fica ESTIMATE.
# 0/off: nenhuma reserva é criada e vale só a pré-checagem de teto antiga.
STUDIO_BUDGET_GUARD=1
# Estúdio: modo do coordenador de produção.
#   INTERACTIVE    = pausa humana obrigatória depois do roteiro (comportamento antigo);
#   BUDGET_GUARDED = dispensa essa pausa quando a projeção do canal cabe no teto; projeção
#                    desconhecida ou acima do teto volta a exigir humano. A publicação continua
#                    exigindo humano nos dois modos.
STUDIO_PRODUCTION_MODE=BUDGET_GUARDED
# Contingência de publicação: 1 = ligada; 0 desliga o upload. Vale após `docker compose up -d renderer`.
STUDIO_PUBLICATION_ENABLED=1
# Estúdio: tetos de gasto pago — PRÉ-REQUISITO do guard acima. Com o teto em 0 (default do código)
# NENHUMA chamada paga é executada (a API responde 403 "budget denied"): defina os dois antes de
# ligar o guard. `MAX_COST_USD_PER_VIDEO` limita o gasto pago por vídeo; `MAX_COST_USD_PER_MONTH` é
# o teto mensal do projeto. O canal pode ter limites próprios (tela Canais → orçamento).
MAX_COST_USD_PER_VIDEO=
MAX_COST_USD_PER_MONTH=
# Estúdio: cofre de segredos (F10-07). Tokens de OAuth do YouTube ficam fora do banco e nunca no
# Project.config devolvido ao browser. Vazio usa <STUDIO_STORAGE_ROOT>/secrets (permissão 0700).
STUDIO_SECRETS_ROOT=
# Estúdio: roteamento de provider em modo produção (F06.T02). Ligado (1), exclui providers de
# demonstração/placeholder do roteamento; desligado (vazio/0) preserva o painel e o dev. Só uma
# instalação real deve ligar. O Compose encaminha esta variável e STUDIO_SECRETS_ROOT ao container.
STUDIO_PROVIDER_PRODUCTION=
