POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS
TZ=America/Sao_Paulo
# Script provider: auto (Gemini if GEMINI_API_KEY is set, else demo) | demo | gemini | vertex | opencode
AI_PROVIDER=auto

# Gemini API (API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vertex AI (Application Default Credentials; see docs/06-vertex-ai.md).
# Use a project YOU own and are allowed to bill. There is no default project on purpose.
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash
# Only with docker-compose.vertex.yml: host path of the ADC / service account JSON.
GCP_CREDENTIALS_FILE=

# OpenCode bridge (OpenAI via OAuth login of OpenCode; see docs/07-openai-luna-oauth.md).
# Run scripts/opencode-bridge.py on the HOST. Token: >= 16 random chars, different from other secrets.
OPENCODE_BRIDGE_TOKEN=
OPENCODE_MODEL=openai/gpt-6-luna
OPENCODE_BRIDGE_PORT=8787
OPENCODE_BRIDGE_URL=http://host.docker.internal:8787
