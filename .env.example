POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS
TZ=America/Sao_Paulo
# Script provider: auto (Gemini if GEMINI_API_KEY is set, else demo) | demo | gemini | vertex | opencode
AI_PROVIDER=auto

# Gemini API (API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vertex AI (Application Default Credentials; see docs/06-vertex-ai.md).
# Use a project YOU own and are allowed to bill. There is no default project on purpose.
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash
# Only with docker-compose.vertex.yml: host path of the ADC / service account JSON.
GCP_CREDENTIALS_FILE=

# OpenCode bridge (OpenAI via OAuth login of OpenCode; see docs/07-openai-luna-oauth.md).
# Run scripts/opencode-bridge.py on the HOST. Token: >= 16 random chars, different from other secrets.
OPENCODE_BRIDGE_TOKEN=
OPENCODE_MODEL=openai/gpt-6-luna
# Imagens do modo rich: só modelos ':free' (o bridge recusa os demais).
OPENCODE_IMAGE_MODEL=openrouter/recraft/recraft-v4.1-flash-v2:free
# Renderer: opencode (via bridge) ou placeholder (degradê local, sem rede)
IMAGE_PROVIDER=opencode
OPENCODE_BRIDGE_PORT=8787
OPENCODE_BRIDGE_URL=http://host.docker.internal:8787
# Estúdio: provedor de imagem (opencode:<modelo>:free | placeholder:gradient | stock:pexels) e chave do Pexels
# Gere credenciais aleatórias distintas e persistentes em .env privado; veja docs/17-studio-auth.md.
STUDIO_BROWSER_USER=
STUDIO_BROWSER_PASSWORD=
STUDIO_WORKER_TOKEN=
STUDIO_IMAGE=
PEXELS_API_KEY=
# Estúdio: reserva preventiva de orçamento nos caminhos pagos (opt-in; desligado por padrão).
# 0/off: nenhuma reserva é criada e vale só a pré-checagem de teto antiga. 1/on: editorial, imagem,
# voz e pontuação de ideias exigem reserva; custo sem evidência de cobrança fica ESTIMATE.
STUDIO_BUDGET_GUARD=0
# Estúdio: cofre de segredos (F10-07). Tokens de OAuth do YouTube ficam fora do banco e nunca no
# Project.config devolvido ao browser. Vazio usa <STUDIO_STORAGE_ROOT>/secrets (permissão 0700).
STUDIO_SECRETS_ROOT=
